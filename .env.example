# Copy this file to .env and fill in the values. .env is gitignored.

# --- Zoom login ---
ZOOM_EMAIL=
ZOOM_PASSWORD=

# --- Microsoft 365 / SharePoint login ---
MS_EMAIL=
MS_PASSWORD=

# --- Spreadsheets (defaults are already set; override only if they move) ---
# RECORDINGS_SHEET_URL=https://sandler365.sharepoint.com/:x:/s/DeltaCo-Op/IQBxt627GUxiTLI_a9cUx1hTAWSnUbvm4Da7du0azm4wW28?e=N6U66z
# CALENDAR_SHEET_URL=https://sandler365.sharepoint.com/:x:/s/DeltaCo-Op/IQAeDxMgasewR4q-W74FVmqXAdqBizRl9oAXxruJPld1hJo?e=UljcO9

# --- Options ---
# Set to false to watch the browser while it works (useful while tuning).
HEADLESS=true
# true = do everything except write to the spreadsheet (just logs what it would write).
DRY_RUN=false
# How dates in the calendar sheet are written: MDY (9/28/2026) or DMY (28/9/2026).
SHEET_DATE_ORDER=MDY
# If the recording isn't in Zoom yet (still processing), keep checking this many minutes.
RECORDING_WAIT_MINUTES=30
